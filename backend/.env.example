# ChaCeylon Express Backend Environment Configuration
# Copy this file to backend/.env and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=tea_herbal_db

# Security & JSON Web Token (generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost
